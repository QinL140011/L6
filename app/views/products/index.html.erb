<h1>商品一覧</h1>

<hr>

<%= link_to "商品登録", new_product_path, class: "btn btn-primary btn-sm" %>

<hr>

<div class="row row-cols-1 row-cols-md-3 g-3">
  <% @products.each do |p| %>
    <div class="col">
      <div class="card h-100">
        <div class="card-body d-flex flex-column">
          <h5 class="card-title">
            <%= link_to p.name, new_cartitem_path(product_id: p.id) %>
            <%= link_to "商品削除", product_path(p), class: "btn btn-outline-danger btn-sm",
                data: { turbo_method: :delete, turbo_confirm: "商品を削除しますか？" } %>
          </h5>
          <p class="card-text text-danger">¥<%= p.price %></p>

          <div class="mt-auto">
            <%= form_with url: cartitems_path, method: :post, data: { turbo: false }, class: "d-flex gap-2 mb-2" do |f| %>
              <%= hidden_field_tag :product_id, p.id %>
              <%= hidden_field_tag :from, "products" %>
              <%= number_field_tag :qty, 1, min: 1, class: "form-control form-control-sm", style: "width:70px" %>
              <%= f.submit "カートに追加", class: "btn btn-success btn-sm" %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>

<hr>

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h5 class="card-title mb-0">
        <%= link_to "カート", cart_path(current_cart), class: "btn btn-secondary btn-sm" %></h5>
    </div>

    <% if @cart_items.empty? %>
      <p class="mb-0">カートは空です。</p>
    <% else %>
      <table class="table table-sm mb-0">
        <thead>
          <tr><th>商品名</th><th>単価</th><th>数量</th><th>小計</th><th>操作</th></tr>
        </thead>
        <tbody>
          <% @cart_items.each do |item| %>
            <tr>
              <td><%= item.product.name %></td>
              <td>¥<%= item.product.price %></td>
              <td><%= item.qty %></td>
              <td>¥<%= item.product.price * item.qty %></td>
              <td>
                <%= link_to "削除", cartitem_path(item, from: "products"),
                      class: "btn btn-outline-danger btn-sm",
                      data: { turbo_method: :delete, turbo_confirm: "削除？" } %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <p class="mt-3 mb-0"><strong>合計: ¥<%= @total %></strong></p>
    <% end %>
  </div>
</div>